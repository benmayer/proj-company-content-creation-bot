# Copy to .env (never committed) and fill in.
# Trello MCP credentials (get the API key at https://trello.com/app-key).
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token

# LLM provider and key names are TBD (card 09). Add each variable here when it is introduced.

# Trello MCP server (.mcp.json). Get both at https://trello.com/power-ups/admin
# Claude Code does not read .env itself: start it with `set -a; source .env; set +a; claude`
TRELLO_API_KEY=
TRELLO_TOKEN=
