# Copy to .env (never committed) and fill in.
# Trello MCP credentials (get the API key at https://trello.com/app-key).
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token

# LLM provider: OpenAI (card 09). Read only by src/llm_integration.py.
OPENAI_API_KEY=
# Model name to call, e.g. one listed at https://platform.openai.com/docs/models
LLM_MODEL=

# Trello MCP server (.mcp.json). Get both at https://trello.com/power-ups/admin
# Claude Code does not read .env itself: start it with `set -a; source .env; set +a; claude`
TRELLO_API_KEY=
TRELLO_TOKEN=

# Shared password for the Streamlit UI (card 20). Required on Render (the app stays locked without it);
# optional locally. Set it in the Render dashboard, never in git.
APP_PASSWORD=

# Self-learning feedback file (card 19). Default: outputs/feedback.jsonl, which Render wipes on every deploy.
# On Render, attach a persistent disk (paid instances only) mounted at /var/data and set:
# FEEDBACK_STORE_PATH=/var/data/feedback.jsonl
FEEDBACK_STORE_PATH=
